if(NOT DEFINED SCORIA_ASSET_ROOT)
  set(SCORIA_ASSET_ROOT "${PROJECT_SOURCE_DIR}/assets")
endif()
file(READ "${SCORIA_ASSET_ROOT}/manifest.json" manifest)
string(JSON count LENGTH "${manifest}" assets)
math(EXPR last "${count}-1")
foreach(i RANGE 0 ${last})
  string(JSON path GET "${manifest}" assets ${i} file)
  string(JSON expected GET "${manifest}" assets ${i} sha256)
  if(NOT EXISTS "${SCORIA_ASSET_ROOT}/${path}")
    message(FATAL_ERROR "Required asset missing: ${path}")
  endif()
  file(SHA256 "${SCORIA_ASSET_ROOT}/${path}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Asset checksum mismatch: ${path}")
  endif()
endforeach()
